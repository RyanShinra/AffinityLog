{
    "cSpell.words": [
        "auprc",
        "auroc",
        "developability",
        "fasta",
        "immunogenicity",
        "ondelete",
        "polyreactivity",
        "sessionmaker",
        "thermostability"
    ],
    "cSpell.ignorePaths": [
        "package-lock.json",
        "node_modules",
        "vscode-extension",
        ".git/{info,lfs,logs,refs,objects}/**",
        ".git/{index,*refs,*HEAD}",
        ".vscode",
        ".vscode-insiders",
        "sample_data/structures"
    ],
    "cSpell.ignoreWords": [
        "venv",
    ],
    "continue.enableNextEdit": false,
    "editor.inlineSuggest.enabled": true,
    "editor.inlineSuggest.minShowDelay": 200,
    "editor.inlineSuggest.suppressSuggestions": true,
    "editor.quickSuggestions": {
        "other": "offWhenInlineCompletions",
        "comments": "off",
        "strings": "off",

    },
    "editor.quickSuggestionsDelay": 500,
    "editor.inlineSuggest.suppressInSnippetMode": false,
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    }
}
